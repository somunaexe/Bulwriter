# Copy this file to .env (already gitignored) and fill in real values —
# docker-compose reads .env automatically for the ${VAR} substitutions in
# docker-compose.yml. Only backend/.env is picked up by the backend
# itself when running outside Docker (godotenv.Load() in main.go); this
# root .env is for docker-compose only.

# Local-only Postgres credentials — these never leave the docker-compose
# network, so plain defaults are fine. Only override if you want
# something different locally.
DB_USER=bulwriter
DB_PASSWORD=bulwriter_dev
DB_NAME=bulwriter

# Required. From your Clerk dashboard → API Keys → Secret keys. Never
# commit a real value — this is a backend-only credential, distinct from
# the publishable key embedded in frontend/src/index.html.
CLERK_SECRET_KEY=

# Optional — defaults to Bulwriter's own Clerk instance if unset. Only
# override if you're running against a different Clerk application.
CLERK_FRONTEND_API=https://wanted-gelding-91.clerk.accounts.dev

# Optional. Only needed for the story bible "Generate from document"
# feature (internal/anthropic) — leave unset to leave that feature
# disabled with a clear error instead of a confusing one.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional. From your Stripe dashboard → Developers → API keys. Only
# needed for the public /donate page (internal/donation) — leave unset to
# leave donations disabled with a clear error instead of a confusing one.
# Use a sk_test_... key while developing; only production should ever see
# a live sk_live_... key.
STRIPE_SECRET_KEY=

# Optional. From the Stripe dashboard when you add a webhook endpoint
# (Developers → Webhooks → Add endpoint, pointed at
# <your-backend>/api/donate/webhook, listening for
# checkout.session.completed) — Stripe shows you the signing secret
# (whsec_...) once, at creation. Without this, donations still work end
# to end, but there's no server-side record that a checkout actually
# completed — see internal/donation's webhook handler.
STRIPE_WEBHOOK_SECRET=

# Optional — where Stripe sends a donor back after checkout. Defaults to
# Bulwriter's production frontend if unset; override locally so the
# success/cancel redirect lands on your dev server instead, e.g.
# http://localhost:4200
FRONTEND_URL=

# Optional. From sentry.io — Settings → Projects → (your project) →
# Client Keys (DSN). Leave unset to run without error tracking; a
# production panic or internal error is otherwise only visible if a user
# happens to report it.
SENTRY_DSN=
