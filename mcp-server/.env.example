# Copy this file to .env and fill in your own values. Never commit .env.

# Bulwriter's Clerk secret key — same value already set on the Railway
# backend (Railway dashboard → bulwriter-backend service → Variables).
CLERK_SECRET_KEY=sk_live_...

# Your personal Clerk session id, so the server can mint fresh JWTs and act
# as you. See README.md for how to grab this from your browser.
CLERK_SESSION_ID=sess_...

# Optional — defaults to the production API.
# BULWRITER_API_URL=https://bulwriter-production.up.railway.app/api

# --- Only needed to run server-http.ts (the remote claude.ai connector) ---
# This server's own public HTTPS URL (e.g. the domain Railway assigns it).
# PUBLIC_URL=https://bulwriter-mcp-production.up.railway.app

# The password claude.ai's connector login screen will ask for. Pick a long
# random value — anyone with it can act on your Bulwriter account through
# this server. Generate one with: openssl rand -hex 24
# MCP_OAUTH_PASSWORD=
